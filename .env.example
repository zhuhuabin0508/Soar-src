# ===== SOAR 平台环境变量示例 =====
#
# 使用方法：
#   1. 复制本文件为 .env.dev：cp .env.example .env.dev
#   2. 按需修改各项值（务必修改 JWT_SECRET 和数据库密码）
#   3. bash dev.sh up  或  docker compose --env-file .env.dev up -d
#
# 安全提示：
#   - .env.dev / .env 已在 .gitignore 中，不会被提交
#   - 务必使用强随机 JWT（可用 python -c "import secrets;print(secrets.token_urlsafe(32))"）

# ---------- PostgreSQL 数据库 ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # ⚠️ 生产环境必须修改
POSTGRES_DB=soar

# ---------- 鉴权与安全 ----------
# JWT 签名密钥：生产环境必须注入强随机值（>=32 字节）
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=soar-dev-secret-change-me-in-production-please

# JWT 访问令牌有效期（分钟），默认 1440（24 小时）
# JWT_EXPIRE_MINUTES=1440

# OTP 验证码明文回显开关（仅本地开发调试用，生产必须保持 false 或删除）：
# 未配置 SMTP 且此开关为 true 时，/auth/otp/send 会在响应中返回 dev_code。
# ENABLE_DEV_CODE=true

# ---------- 初始管理员（首次启动 seed 时创建）----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123        # ⚠️ 生产环境必须修改

# ---------- CORS 允许的源（逗号分隔）----------
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------- LLM API Key（可选，留空走 Mock 降级）----------
# LLM 的 API Key 在系统「模型设置」页面配置，存储于数据库，无需在此填写
# ANTHROPIC_API_KEY=

# ---------- 后端自愈：事件循环看门狗（见 docs/后端假死自愈与排查.md）----------
# 判定阈值（秒）：超时未响应即打印全线程栈并退出进程，由 restart: unless-stopped 拉起
# LOOP_WATCHDOG_TIMEOUT=90
# LOOP_WATCHDOG_INTERVAL=5
# LOOP_WATCHDOG_ENABLED=true

# ---------- 连接串（通常无需修改，自动使用上面的数据库配置）----------
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/soar
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- 容器出网代理（仅内网/受限网络部署需要）----------
# docker-compose.yml 已为 frontend/backend 等容器注入 HTTP(S)_PROXY，
# 默认值指向内网代理 http://10.223.132.41:8999（与宿主机 Docker daemon 一致）。
# 若你的环境不需要代理，可在此设为空覆盖默认值：
# NPM_HTTP_PROXY=
# NPM_HTTPS_PROXY=
# NPM_NO_PROXY=localhost,127.0.0.1

