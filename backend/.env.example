DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/soar
REDIS_PASSWORD=12345678
REDIS_URL=redis://:12345678@localhost:6379/0
CELERY_BROKER_URL=redis://:12345678@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:12345678@localhost:6379/1

# ===== XDR 开放性 OpenAPI（query_xdr_openapi 工具使用）=====
# 本文件是提交到仓库的模板，只放空占位；真实值只允许写入 backend/.env（已 gitignore）
# XDR 平台地址（带协议）；来源：XDR「配置管理 → 系统设置 → 开放性」
XDR_OPENAPI_HOST=
# 联动码（等同访问凭证，最小权限）：只允许写入部署环境 .env，禁止入库/入提示词/入日志/入 Git
# 来源：XDR「配置管理 → 系统设置 → 开放性 → 联动码管理」
XDR_OPENAPI_AUTH_CODE=
# 单次请求超时（秒），须小于引擎工具总超时 30s
XDR_OPENAPI_TIMEOUT=20
# 默认校验 TLS 证书；自签证书环境需显式设为 false
XDR_OPENAPI_VERIFY_SSL=true
# 是否允许非查询类方法（PUT/PATCH/DELETE），默认禁止
XDR_OPENAPI_ALLOW_WRITE=false
